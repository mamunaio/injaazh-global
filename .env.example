# ==============================================================================
# INJAAZH GLOBAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any file containing real credentials to git.
# ==============================================================================

# 1. Resend API Key (for transactional lead notifications & audit reports)
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. Agency Admin Email (recipient of project pipeline inquiries)
ADMIN_EMAIL=info@injaazh.com

# 3. Google PageSpeed Insights API Key (for live AI website audits)
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=your_google_psi_api_key_here

# 4. WhatsApp Meta Cloud API Webhook Verification Token
# Set this exact value in Meta App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=your_strong_random_verify_token_here
